rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }
    function isUserOrAdmin() {
      return isSignedIn() &&
        (request.auth.token.role == 'user' || request.auth.token.role == 'admin');
    }

    // 名簿: 認証済みは読取/作成/更新可、削除はadminのみ
    // roleフィールドは自分のFirebase Authクレームと一致する値のみ書き込み可（昇格防止）
    match /members/{memberId} {
      allow read: if isUserOrAdmin();
      allow create: if isUserOrAdmin() &&
        (!('role' in request.resource.data) ||
          request.resource.data.role == request.auth.token.role);
      allow update: if isUserOrAdmin() &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) ||
          // roleが変更される場合: 自分のクレームと一致 かつ 既存がadminでない（admin→user降格を防止）
          (request.resource.data.role == request.auth.token.role &&
           resource.data.get('role', '') != 'admin'));
      allow delete: if isAdmin();
    }

    // シフト: 認証済みは読取/作成可、更新はadminのみ（承認・調整）
    // 例外: userは自分の確定シフトをdelete_requestedに変更可（削除依頼）
    // 削除: planはuser/admin両方可（キャンセル）、delete_requestedはadminのみ可
    match /shifts/{shiftId} {
      allow read: if isUserOrAdmin();
      allow create: if isUserOrAdmin();
      allow update: if isAdmin() ||
        (isUserOrAdmin() &&
         request.resource.data.status == 'delete_requested' &&
         resource.data.diff(request.resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'version']));
      allow delete: if isAdmin() ||
        (isUserOrAdmin() && resource.data.status == 'plan');
    }

    // 全体掲示板: 認証済みは読取可、adminのみ書込/削除
    match /boardPublic/{docId} {
      allow read: if isUserOrAdmin();
      allow write: if isAdmin();
    }

    // admin非公開メモ: adminのみ読み書き
    match /boardPrivate/{docId} {
      allow read, write: if isAdmin();
    }

    // 承認ログ: adminのみ読み書き
    match /approvalLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // 削除済み掲示板: adminのみ読み書き（ソフトデリート用）
    match /boardPublicDeleted/{docId} {
      allow read, write: if isAdmin();
    }
    match /boardPrivateDeleted/{docId} {
      allow read, write: if isAdmin();
    }

    // システム設定（LINEグループIDなど）: userは読取、adminのみ書込
    match /config/{docId} {
      allow read: if isUserOrAdmin();
      allow write: if isAdmin();
    }

    // 出勤依頼: adminが作成・更新、認証済みが読取
    match /shiftRequests/{docId} {
      allow read: if isUserOrAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 出勤依頼の送信記録: バックエンド(AdminSDK)が書込、認証済みが読取
    match /shiftRequestInvites/{docId} {
      allow read: if isUserOrAdmin();
      allow write: if false; // バックエンドのFirebase Admin SDKのみ書込可
    }
  }
}
