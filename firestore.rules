rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }
    function isUserOrAdmin() {
      return isSignedIn() &&
        (request.auth.token.role == 'user' || request.auth.token.role == 'admin');
    }
    // field が存在しないか、存在する場合は string かつ maxLen 以下
    function strMax(field, maxLen) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is string &&
         request.resource.data[field].size() <= maxLen);
    }
    // field が必須: 存在・string・1文字以上・maxLen 以下
    function strRequired(field, maxLen) {
      return field in request.resource.data &&
        request.resource.data[field] is string &&
        request.resource.data[field].size() > 0 &&
        request.resource.data[field].size() <= maxLen;
    }

    // 名簿: 認証済みは読取/作成/更新可、削除はadminのみ
    // create: roleフィールドは自分のFirebase Authクレームと一致する値のみ書き込み可（昇格防止）
    // update: roleフィールドは書き込み禁止（アプリコードはupdateDocでname/updatedAtのみ更新）
    match /members/{memberId} {
      allow read: if isUserOrAdmin();
      allow create: if isUserOrAdmin() &&
        strRequired('name', 15) &&
        (!('role' in request.resource.data) ||
          request.resource.data.role == request.auth.token.role);
      allow update: if isUserOrAdmin() &&
        strMax('name', 15) &&
        !('role' in request.writeFields);
      allow delete: if isAdmin();
    }

    // シフト: 認証済みは読取/作成可、更新はadminのみ（承認・調整）
    // 例外: userは確定シフトをdelete_requestedに変更可（急な予定変更のため locked 後も常に許可）
    // 削除: planかつlocked=falseのみuser可（キャンセル）、locked=trueはadminのみ
    match /shifts/{shiftId} {
      allow read: if isUserOrAdmin();
      allow create: if isUserOrAdmin() &&
        strRequired('memberName', 15) &&
        strMax('subject', 100) &&
        strMax('place', 20);
      allow update: if isAdmin() ||
        (isUserOrAdmin() &&
         request.resource.data.status == 'delete_requested' &&
         resource.data.diff(request.resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'version']));
      allow delete: if isAdmin() ||
        (isUserOrAdmin() &&
         resource.data.status == 'plan' &&
         resource.data.get('locked', false) != true);
    }

    // 全体掲示板: 認証済みは読取可、adminのみ書込/削除
    match /boardPublic/{docId} {
      allow read: if isUserOrAdmin();
      allow create, update: if isAdmin() &&
        strMax('title', 100) &&
        strMax('body', 2000);
      allow delete: if isAdmin();
    }

    // admin非公開メモ: adminのみ読み書き
    match /boardPrivate/{docId} {
      allow read, write: if isAdmin();
    }

    // 承認ログ: adminのみ読み書き
    match /approvalLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // 削除済み掲示板: adminのみ読み書き（ソフトデリート用）
    match /boardPublicDeleted/{docId} {
      allow read, write: if isAdmin();
    }
    match /boardPrivateDeleted/{docId} {
      allow read, write: if isAdmin();
    }

    // システム設定（LINEグループIDなど）: userは読取、adminのみ書込
    match /config/{docId} {
      allow read: if isUserOrAdmin();
      allow write: if isAdmin();
    }

    // 出勤依頼: adminが作成・更新、認証済みが読取
    match /shiftRequests/{docId} {
      allow read: if isUserOrAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 出勤依頼の送信記録: バックエンド(AdminSDK)が書込、認証済みが読取
    match /shiftRequestInvites/{docId} {
      allow read: if isUserOrAdmin();
      allow write: if false; // バックエンドのFirebase Admin SDKのみ書込可
    }

    // カレンダーイベント（定休日・臨時休業等）: 認証済みは読取、adminのみ作成/削除
    match /calendarEvents/{eventId} {
      allow read: if isUserOrAdmin();
      allow create: if isAdmin() &&
        strRequired('subject', 50) &&
        strRequired('date', 10);
      allow delete: if isAdmin();
    }

    // 名前変更トークン: トークン64文字が実質シークレットなので全員読取可
    // フロントからは used: false→true の更新のみ許可。発行・削除はAdmin SDKのみ
    match /nameChangeTokens/{token} {
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used'])
                   && request.resource.data.used == true
                   && resource.data.used == false;
      allow create, delete: if false;
    }
  }
}
