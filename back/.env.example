# LINE Messaging API
CHANNEL_SECRET=your_channel_secret
CHANNEL_ACCESS_TOKEN=your_channel_access_token

# LINE送信先ID
# LINE_GROUP_ID はフォールバック用（通常不要: Firestoreに自動保存される）
# LINE_SELF_USER_ID は必須（エラー通知・管理者DM用）
LINE_GROUP_ID=your_line_group_id
LINE_SELF_USER_ID=your_line_self_user_id

# CORSで許可するVercelドメイン
ALLOWED_ORIGIN=https://your-app.vercel.app

# Firebase Admin SDK（Firestoreアクセス・名前登録・グループ登録に必要）
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 名前未一致時のLINE返信内に埋め込むフロントURL（任意: 未設定でもエラーにならない）
FRONTEND_URL=https://your-app.vercel.app

# PORT は Heroku が自動設定するため、Heroku Config Vars には設定しないこと
